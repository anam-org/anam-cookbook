# Anam
ANAM_API_KEY=your_anam_api_key
ANAM_AVATAR_ID=your_cara_4_avatar_id
# Director-note cues require a Cara-4 avatar.
ANAM_AVATAR_MODEL=cara-4

# Daily room the avatar publishes into. Open this URL in a browser to talk to it.
DAILY_ROOM_URL=https://your-domain.daily.co/your-room
# Optional meeting tokens (required only for private rooms).
DAILY_AVATAR_TOKEN=
DAILY_BOT_TOKEN=
# DAILY_AVATAR_USER_NAME=anam-avatar

# STT / TTS / LLM
DEEPGRAM_API_KEY=your_deepgram_api_key
CARTESIA_API_KEY=your_cartesia_api_key
OPENAI_API_KEY=your_openai_api_key
