ANAM_API_KEY=your_anam_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Director Notes only work with Cara 4 avatars. Use an avatar that supports
# Cara-4.1 Express. PERSONA_NAME is shown on the page.
PERSONA_NAME=ElevenLabs Agent
ANAM_AVATAR_ID=
ELEVENLABS_AGENT_ID=

# Signs the start tickets that protect /api/anam-session. Keep it secret and
# never expose it to the browser (no NEXT_PUBLIC_ prefix). Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Your site's public origin, such as https://example.com, with no path.
# Optional locally. Set it in production: without it, the expected origin comes
# from the request's Host header, so any hostname that reaches the server passes.
APP_ORIGIN=
