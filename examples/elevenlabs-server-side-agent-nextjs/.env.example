ANAM_API_KEY=your_anam_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Director Notes only work with Cara 4 avatars.
PERSONA_NAME=ElevenLabs Agent
ANAM_AVATAR_ID=
ELEVENLABS_AGENT_ID=

# Signs the start tickets that protect /api/anam-session. Keep it secret and
# never expose it to the browser (no NEXT_PUBLIC_ prefix). Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: your site's public origin, such as https://example.com. Set it if a
# proxy in front of the app changes the Host header.
APP_ORIGIN=
